{
  "name": "@gauss-horizon/cli",
  "version": "0.1.0",
  "description": "Command line interface for Gauss Horizon database connections, schema, and safe queries",
  "keywords": [
    "ai-agent",
    "automation",
    "cli",
    "codex",
    "database",
    "gauss-horizon",
    "mysql",
    "postgresql",
    "terminal"
  ],
  "homepage": "https://github.com/Gaussian-id/Gauss-Horizon/tree/main/packages/cli",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaussian-id/Gauss-Horizon",
    "directory": "packages/cli"
  },
  "bin": {
    "gauss-horizon": "bin/gauss-horizon.js"
  },
  "files": [
    "bin"
  ],
  "type": "module",
  "scripts": {
    "start": "cargo run -p gauss-horizon-cli --no-default-features --",
    "test": "cargo test -p gauss-horizon-cli --no-default-features",
    "build": "cargo build -p gauss-horizon-cli --release --no-default-features",
    "prepublishOnly": "node --check bin/gauss-horizon.js"
  },
  "optionalDependencies": {
    "@gauss-horizon/cli-darwin-arm64": "workspace:*",
    "@gauss-horizon/cli-darwin-x64": "workspace:*",
    "@gauss-horizon/cli-linux-arm64-gnu": "workspace:*",
    "@gauss-horizon/cli-linux-x64-gnu": "workspace:*",
    "@gauss-horizon/cli-win32-arm64": "workspace:*",
    "@gauss-horizon/cli-win32-x64": "workspace:*"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
