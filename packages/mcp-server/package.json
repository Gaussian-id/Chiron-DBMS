{
  "name": "@gauss-horizon/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Gauss Horizon \u2014 query databases from Claude Code, Cursor, and other AI agents",
  "keywords": [
    "ai-agent",
    "claude",
    "database",
    "gauss-horizon",
    "mcp",
    "mysql",
    "postgresql"
  ],
  "homepage": "https://github.com/Gaussian-id/Gauss-Horizon/tree/main/packages/mcp-server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaussian-id/Gauss-Horizon",
    "directory": "packages/mcp-server"
  },
  "bin": {
    "gauss-horizon-mcp-server": "bin/gauss-horizon-mcp-server.js",
    "mcp-server": "bin/gauss-horizon-mcp-server.js"
  },
  "files": [
    "bin",
    "server.json"
  ],
  "type": "module",
  "scripts": {
    "start": "cargo run -p gauss-horizon-mcp --",
    "test": "cargo build -p gauss-horizon-mcp && vitest run --config vitest.config.ts",
    "build": "node --check bin/gauss-horizon-mcp-server.js",
    "prepublishOnly": "node bin/gauss-horizon-mcp-server.js --verify-platform"
  },
  "optionalDependencies": {
    "@gauss-horizon/mcp-darwin-arm64": "workspace:*",
    "@gauss-horizon/mcp-darwin-x64": "workspace:*",
    "@gauss-horizon/mcp-linux-arm64-gnu": "workspace:*",
    "@gauss-horizon/mcp-linux-x64-gnu": "workspace:*",
    "@gauss-horizon/mcp-win32-arm64": "workspace:*",
    "@gauss-horizon/mcp-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "mcpName": "io.github.Gaussian-id/Gauss-Horizon"
}
