{
  "name": "@chiron-horizon/plugin-cli",
  "version": "0.1.0",
  "description": "Create and package Chiron Horizon plugins without compiling the Chiron Horizon plugin CLI",
  "keywords": [
    "cli",
    "database",
    "chiron-horizon",
    "plugin",
    "plugin-development"
  ],
  "homepage": "https://github.com/Gaussian-id/Gauss-Horizon/tree/main/plugins",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaussian-id/Gauss-Horizon",
    "directory": "packages/plugin-cli"
  },
  "bin": {
    "chiron-horizon-plugin": "bin/chiron-horizon-plugin.js"
  },
  "files": [
    "bin",
    "README.md",
    "sdk-root",
    "dev-runtime"
  ],
  "type": "module",
  "scripts": {
    "build": "node --check bin/chiron-horizon-plugin.js && node --check scripts/stage-sdk.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "node scripts/stage-sdk.mjs && node scripts/stage-dev.mjs",
    "postpack": "node scripts/stage-sdk.mjs --clean && node scripts/stage-dev.mjs --clean",
    "prepublishOnly": "npm run build && npm test"
  },
  "optionalDependencies": {
    "@chiron-horizon/plugin-cli-darwin-arm64": "workspace:*",
    "@chiron-horizon/plugin-cli-darwin-x64": "workspace:*",
    "@chiron-horizon/plugin-cli-linux-arm64-gnu": "workspace:*",
    "@chiron-horizon/plugin-cli-linux-x64-gnu": "workspace:*",
    "@chiron-horizon/plugin-cli-win32-arm64": "workspace:*",
    "@chiron-horizon/plugin-cli-win32-x64": "workspace:*"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
