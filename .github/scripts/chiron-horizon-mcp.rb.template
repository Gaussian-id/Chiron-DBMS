class ChironHorizonMcp < Formula
  desc "Native MCP server for Chiron Horizon database connections, schema, and safe queries"
  homepage "https://github.com/Gaussian-id/Chiron-DBMS"
  version "__VERSION__"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.intel?
      url "https://github.com/Gaussian-id/Chiron-DBMS/releases/download/packages-v#{version}/chiron-horizon-mcp-darwin-x64.tar.gz"
      sha256 "__SHA_DARWIN_X64__"
    else
      url "https://github.com/Gaussian-id/Chiron-DBMS/releases/download/packages-v#{version}/chiron-horizon-mcp-darwin-arm64.tar.gz"
      sha256 "__SHA_DARWIN_ARM64__"
    end
  end
  on_linux do
    if Hardware::CPU.intel?
      url "https://github.com/Gaussian-id/Chiron-DBMS/releases/download/packages-v#{version}/chiron-horizon-mcp-linux-x64-gnu.tar.gz"
      sha256 "__SHA_LINUX_X64__"
    else
      url "https://github.com/Gaussian-id/Chiron-DBMS/releases/download/packages-v#{version}/chiron-horizon-mcp-linux-arm64-gnu.tar.gz"
      sha256 "__SHA_LINUX_ARM64__"
    end
  end

  def install
    bin.install "chiron-horizon-mcp"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/chiron-horizon-mcp --version")
  end
end
