{
  "database": "postgresql",
  "name": "PostgreSQL",
  "version": "17.4",
  "displayVersion": "17.4",
  "image": "docker.cnb.cool/znb/images/postgres:17.4",
  "platforms": ["linux/amd64", "linux/arm64"],
  "service": "database",
  "defaultPort": 5432,
  "connection": { "host": "127.0.0.1", "port": 10301, "username": "postgres", "password": "123456", "database": "chiron-horizon" },
  "hostPorts": { "DB_PORT": 10301 },
  "shell": ["env", "PGPASSWORD=${DB_PASSWORD}", "psql", "-h", "127.0.0.1", "-p", "5432", "-U", "postgres", "-d", "chiron-horizon"],
  "smoke": { "steps": [{ "name": "query initialized row over TCP", "command": ["env", "PGPASSWORD=${DB_PASSWORD}", "psql", "-h", "127.0.0.1", "-p", "5432", "-U", "postgres", "-d", "chiron-horizon", "-Atc", "SELECT note FROM chiron_horizon_smoke WHERE id=1"], "expect": "Chiron Horizon smoke" }] }
}
