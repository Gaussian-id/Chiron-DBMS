{
  "database": "clickhouse",
  "name": "ClickHouse",
  "version": "24.8.14.39",
  "displayVersion": "24.8",
  "image": "docker.cnb.cool/znb/images/clickhouse-server:24.8.14.39",
  "platforms": ["linux/amd64", "linux/arm64"],
  "service": "database",
  "defaultPort": 8123,
  "connection": { "host": "127.0.0.1", "port": 10600, "username": "default", "password": "123456", "database": "gauss-horizon" },
  "hostPorts": { "DB_PORT": 10600 },
  "shell": ["clickhouse-client", "--user", "default", "--password", "${DB_PASSWORD}", "--database", "gauss-horizon"],
  "smoke": { "steps": [{ "name": "query initialized row", "command": ["clickhouse-client", "--user", "default", "--password", "${DB_PASSWORD}", "--database", "gauss-horizon", "--query", "SELECT note FROM gauss_horizon_smoke WHERE id = 1"], "expect": "Gauss Horizon smoke" }] }
}
