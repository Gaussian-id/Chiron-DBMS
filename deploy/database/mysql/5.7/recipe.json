{
  "database": "mysql",
  "name": "MySQL",
  "version": "5.7.44",
  "displayVersion": "5.7",
  "image": "docker.cnb.cool/znb/images/mysql:5.7.44",
  "platforms": ["linux/amd64", "linux/arm64"],
  "service": "database",
  "defaultPort": 3306,
  "connection": { "host": "127.0.0.1", "port": 10100, "username": "root", "password": "123456", "database": "chiron-horizon" },
  "hostPorts": { "DB_PORT": 10100 },
  "shell": ["mysql", "-uroot", "-p${DB_PASSWORD}", "-Dchiron-horizon"],
  "smoke": { "steps": [{ "name": "query initialized row", "command": ["mysql", "-uroot", "-p${DB_PASSWORD}", "-Dchiron-horizon", "-Nse", "SELECT note FROM chiron_horizon_smoke WHERE id=1"], "expect": "Chiron Horizon smoke" }] }
}
